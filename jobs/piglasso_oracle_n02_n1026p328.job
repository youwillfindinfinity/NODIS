#!/bin/bash
#SBATCH --job-name=pig_n02_lg
#SBATCH --output=logs/pig_n02_lg_%A_%a.out
#SBATCH --error=logs/pig_n02_lg_%A_%a.err
#SBATCH --time=05:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=65536M            # 64 GB — ~16 GB/task for 4 parallel tasks
#SBATCH --array=0-49
# piglasso_oracle_n02 — n1026p328 (large config for scalability figure)
# Grid: 4 topologies × 50 reps = 200 tasks
# Each array job handles 4 tasks in parallel → 50 × 4 = 200
# Expected: ~2 h/rep (4× n513p164 which ran ~27 min)
#
# Submit:
#   sbatch --partition=rome jobs/piglasso_oracle_n02_n1026p328.job

NODIS_DIR="$HOME/NODIS"

[[ -f "$NODIS_DIR/snellius_modules.sh" ]] && source "$NODIS_DIR/snellius_modules.sh"
source "$NODIS_DIR/.venv/bin/activate"

TOPOS=("hub" "scale-free" "cluster" "random")
METHOD="piglasso_oracle_n02"
N_REPS=50
TOTAL=200           # 4 topologies × 50 reps
TASKS_PER_JOB=${SLURM_CPUS_PER_TASK}

mkdir -p "$NODIS_DIR/results/raw" "$NODIS_DIR/logs"

for LOCAL_IDX in $(seq 0 $((TASKS_PER_JOB - 1))); do
    FLAT=$(( SLURM_ARRAY_TASK_ID * TASKS_PER_JOB + LOCAL_IDX ))
    [[ $FLAT -ge $TOTAL ]] && break

    TOPO_IDX=$(( FLAT / N_REPS ))
    REP=$(( FLAT % N_REPS ))
    TOPO=${TOPOS[$TOPO_IDX]}

    echo "[$FLAT] topology=${TOPO} config=n1026p328 method=${METHOD} rep=${REP}"

    python "$NODIS_DIR/benchmarks/run_synthetic.py" \
        --topology     "$TOPO"       \
        --config       n1026p328     \
        --method       "$METHOD"     \
        --rep          "$REP"        \
        --prior-weight 0.5           \
        --out          "$NODIS_DIR/results/raw/" &
done

wait

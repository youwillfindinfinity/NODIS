#!/bin/bash
#SBATCH --job-name=ssglasso_n1026
#SBATCH --output=logs/ssglasso_n1026_%A_%a.out
#SBATCH --error=logs/ssglasso_n1026_%A_%a.err
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G                # ~2 GB/task for 4 parallel tasks
#SBATCH --array=0-49            # 50 jobs × 4 tasks = 200 (4 topos × 50 reps)
# Method: ssglasso at n1026p328 for scalability benchmark
# Grid:   4 topologies × 50 reps = 200 tasks
#
# Submit:
#   sbatch --partition=rome jobs/ssglasso_n1026p328.job

NODIS_DIR="$HOME/NODIS"

[[ -f "$NODIS_DIR/snellius_modules.sh" ]] && source "$NODIS_DIR/snellius_modules.sh"
source "$NODIS_DIR/.venv/bin/activate"

TOPOS=("hub" "scale-free" "cluster" "random")
N_REPS=50
N_TOPOS=4
TOTAL=$(( N_TOPOS * N_REPS ))   # 200
TASKS_PER_JOB=4

mkdir -p "$NODIS_DIR/results/raw" "$NODIS_DIR/logs"

for LOCAL_IDX in $(seq 0 $((TASKS_PER_JOB - 1))); do
    FLAT=$(( SLURM_ARRAY_TASK_ID * TASKS_PER_JOB + LOCAL_IDX ))
    [[ $FLAT -ge $TOTAL ]] && break

    TOPO_IDX=$(( FLAT / N_REPS ))
    REP=$(( FLAT % N_REPS ))

    TOPO=${TOPOS[$TOPO_IDX]}

    echo "[$FLAT] topology=${TOPO} config=n1026p328 method=ssglasso rep=${REP}"

    python "$NODIS_DIR/benchmarks/run_synthetic.py" \
        --topology "$TOPO"     \
        --config   n1026p328   \
        --method   ssglasso    \
        --rep      "$REP"      \
        --out      "$NODIS_DIR/results/raw/" &
done

wait

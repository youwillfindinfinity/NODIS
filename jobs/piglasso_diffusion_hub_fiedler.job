#!/bin/bash
#SBATCH --job-name=pig_diff_hf
#SBATCH --output=logs/pig_diff_hf_%A_%a.out
#SBATCH --error=logs/pig_diff_hf_%A_%a.err
#SBATCH --time=00:30:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=28672M            # 16 × 1792 MiB — matches billing unit exactly
#SBATCH --array=0-37            # 38 × 16 = 608 slots (covers 600 tasks)
# Fill missing hub+fiedler delta modes for piglasso diffusion benchmark.
# adj pickles already exist in results/raw/ so no re-fitting is done.
# --delta all skips the existing random CSVs and writes only hub+fiedler.
#
# Grid: 4 topologies × 3 configs × 50 reps = 600 tasks
#
# Submit:
#   sbatch --partition=rome jobs/piglasso_diffusion_hub_fiedler.job

NODIS_DIR="$HOME/NODIS"

[[ -f "$NODIS_DIR/snellius_modules.sh" ]] && source "$NODIS_DIR/snellius_modules.sh"
source "$NODIS_DIR/.venv/bin/activate"

TOPOS=("hub" "scale-free" "cluster" "random")
CONFIGS=("n100p50" "n237p78" "n513p164")
N_REPS=50
N_TOPOS=4
N_CONFIGS=3
TOTAL=$(( N_TOPOS * N_CONFIGS * N_REPS ))   # 600
TASKS_PER_JOB=${SLURM_CPUS_PER_TASK}

mkdir -p "$NODIS_DIR/results/diffusion" "$NODIS_DIR/logs"

for LOCAL_IDX in $(seq 0 $((TASKS_PER_JOB - 1))); do
    FLAT=$(( SLURM_ARRAY_TASK_ID * TASKS_PER_JOB + LOCAL_IDX ))
    [[ $FLAT -ge $TOTAL ]] && break

    TOPO_IDX=$(( FLAT / (N_CONFIGS * N_REPS) ))
    REM1=$(( FLAT % (N_CONFIGS * N_REPS) ))
    CFG_IDX=$(( REM1 / N_REPS ))
    REP=$(( REM1 % N_REPS ))

    TOPO=${TOPOS[$TOPO_IDX]}
    CFG=${CONFIGS[$CFG_IDX]}

    echo "[$FLAT] topology=${TOPO} config=${CFG} method=piglasso rep=${REP}"

    python "$NODIS_DIR/benchmarks/run_diffusion.py" \
        --topology "$TOPO"   \
        --config   "$CFG"    \
        --method   piglasso  \
        --rep      "$REP"    \
        --delta    all       \
        --mode     both      \
        --n-jobs   1         \
        --adj-dir  "$NODIS_DIR/results/raw/" \
        --out      "$NODIS_DIR/results/diffusion/" &
done

wait

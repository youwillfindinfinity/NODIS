<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         max-width: 1000px; margin: 40px auto; padding: 0 20px;
         color: #222; background: #fafafa; }
  h1   { color: #1a1a2e; border-bottom: 2px solid #2c7bb6; padding-bottom: 8px; }
  h2   { color: #2c7bb6; margin-top: 36px; }
  h3   { color: #444; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0; }
  th, td { padding: 8px 12px; text-align: left; border: 1px solid #ddd; }
  th    { background: #2c7bb6; color: white; }
  tr:nth-child(even) { background: #f2f8ff; }
  .metric { display: inline-block; background: #fff; border: 1px solid #d0e4f7;
            border-radius: 6px; padding: 12px 20px; margin: 6px;
            text-align: center; min-width: 120px; }
  .metric .value { font-size: 1.8em; font-weight: bold; color: #2c7bb6; }
  .metric .label { font-size: 0.85em; color: #666; }
  .warn { background: #fff8e1; border-left: 4px solid #f9a825;
          padding: 10px 16px; margin: 10px 0; border-radius: 4px; }
  .figure { text-align: center; margin: 20px 0; }
  .figure img { max-width: 100%; border: 1px solid #ddd; border-radius: 4px; }
  footer { margin-top: 48px; color: #888; font-size: 0.8em;
           border-top: 1px solid #ddd; padding-top: 10px; }
  .section { background: white; padding: 20px; margin: 16px 0;
             border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
</style>
</head>
<body>
<h1>NODIS Inference Report</h1>
<p style="color:#666">{{ title }} &mdash; generated {{ generated_at }}</p>

<!-- 1. Run summary -->
<div class="section">
<h2>1. Run Summary</h2>
<table>
  <tr><th>Parameter</th><th>Value</th></tr>
  {% for k, v in summary.items() %}
  <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
  {% endfor %}
</table>
</div>

<!-- 2. Network overview -->
<div class="section">
<h2>2. Network Overview</h2>
<div>
  <span class="metric"><div class="value">{{ network.n_edges }}</div><div class="label">Edges</div></span>
  <span class="metric"><div class="value">{{ "%.4f"|format(network.density) }}</div><div class="label">Density</div></span>
  <span class="metric"><div class="value">{{ network.n_components }}</div><div class="label">Components</div></span>
  <span class="metric"><div class="value">{{ network.n_isolates }}</div><div class="label">Isolates</div></span>
</div>
</div>

<!-- 3. P-value calibration -->
{% if figures.pvalue_hist %}
<div class="section">
<h2>3. P-value Distribution</h2>
<div class="figure">
  <img src="data:image/png;base64,{{ figures.pvalue_hist }}" alt="P-value histogram">
</div>
</div>
{% endif %}

<!-- 4. Degree distribution -->
{% if figures.degree_dist %}
<div class="section">
<h2>4. Degree Distribution</h2>
<div class="figure">
  <img src="data:image/png;base64,{{ figures.degree_dist }}" alt="Degree distribution">
</div>
</div>
{% endif %}

<!-- 5. Top hub genes -->
{% if hub_genes %}
<div class="section">
<h2>5. Top Hub Genes</h2>
<table>
  <tr><th>Gene</th><th>Degree</th><th>Top Neighbours</th></tr>
  {% for row in hub_genes %}
  <tr>
    <td>{{ row.gene }}</td>
    <td>{{ row.degree }}</td>
    <td>{{ row.top_neighbours }}</td>
  </tr>
  {% endfor %}
</table>
</div>
{% endif %}

<!-- 6. GO enrichment -->
{% if enrichment %}
<div class="section">
<h2>6. GO Enrichment</h2>
<p>{{ enrichment.summary }}</p>
{% if enrichment.table %}
<table>
  <tr><th>Term</th><th>Source</th><th>p-value</th></tr>
  {% for row in enrichment.table %}
  <tr><td>{{ row.term }}</td><td>{{ row.source }}</td><td>{{ "%.2e"|format(row.pvalue) }}</td></tr>
  {% endfor %}
</table>
{% endif %}
</div>
{% endif %}

<!-- 7. QC flags -->
{% if warnings %}
<div class="section">
<h2>7. QC Flags</h2>
{% for w in warnings %}
<div class="warn">⚠ {{ w }}</div>
{% endfor %}
</div>
{% endif %}

<footer>
  Generated by NODIS {{ nodis_version }} &bull; {{ generated_at }}
</footer>
</body>
</html>
